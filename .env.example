# SolSnipBot — modèle de configuration (copiez ce fichier en `.env`)
#
# `.env` n'est JAMAIS versionné (voir .gitignore) : c'est là que vivent vos
# identifiants, jamais dans le code.
#
# Les identifiants GMGN peuvent aussi être lus depuis ~/.config/gmgn/.env ;
# ce fichier-ci n'est qu'une surcharge locale, de priorité plus haute.

# --- Telegram (API officielle, https://my.telegram.org) -------------------
# Créez votre propre application sur my.telegram.org : ne réutilisez pas
# l'identifiant d'autrui, et ne publiez jamais cet API hash.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# --- GMGN (facultatif : sinon ~/.config/gmgn/.env) ------------------------
# GMGN_API_KEY=
# GMGN_PRIVATE_KEY=

# --- Helius (facultatif : sinon tableau de bord → Settings → Secrets) -----
# HELIUS_API_KEY=
